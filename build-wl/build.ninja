  COMMAND = cd /home/starlark/github/GBLink-Firmware/build-wl/src/module && /usr/bin/cmake --regenerate-during-build -S/home/starlark/github/GBLink-Firmware -B/home/starlark/github/GBLink-Firmware/build-wl
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/module/rebuild_cache: phony src/module/CMakeFiles/rebuild_cache.util

