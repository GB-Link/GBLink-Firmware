.program pio_master_mode

.define SD_PIN_OUT 1
.define SD_PIN_IN 1

.define PREP_NEXT_TRANSMISSION_FLAG 0
.define RX_TX_DONE_FLAG 1
.define START_WATCHDOG_FLAG 2

; Between Handshake cycle -> 30097 + cyles from .wraptarget till UART start bit

.wrap_target

set pins, 0b1101 ; pins SD | SO | SI | SC

wait_till_next_transmission:
    jmp y-- wait_till_next_transmission

irq PREP_NEXT_TRANSMISSION_FLAG

set x, 30
wait_for_tx_irq:
    jmp x-- wait_for_tx_irq [9] ; wait for irq to fill fifo with next timing value and tx value

set pins, 0b1100 ; set SC low, martk start of complete transmission

pull noblock
mov y osr ; seat number
transive_loop:
    jmp y-- transmit_data_for_player
    
    receive_data_from_seat:
        set pindirs, 0b0101 ; change SD to input
        set pins, 0b1000 ; pull SO

        ; start poll SD to see when to start sampling
        poll:
            mov isr, ~null      ; ISR = all 1s, shift count reset
            in pins, 2          ; low 2 bits = GP4,GP3
            mov x, ~isr         ; x == 0  <=>  both pins high
            jmp !x poll
        
        set x, 15 [19] ; delay to start sampling between duty cycle
        
        receive_data:
            in pins SD_PIN_IN [14]
            jmp x-- receive_data

        push [16] ; rx value

        set pindirs, 0b1101 ; change SD to output
        set pins, 0b1100 [29]
        jmp transive_loop

    transmit_data_for_player:
        mov x, status
        jmp x-- done ; tx fifo empty
        pull noblock
        set pins, 0b0100 [15] ; UART start bit

        transmit_data:
            out pins, SD_PIN_OUT [14]
            jmp !osre transmit_data 

        set pins, 0b1100 [15] ; UART stop bit
        jmp transive_loop

done:
irq RX_TX_DONE_FLAG [31]

pull ; timing value for next transmission
mov y osr ; store in y for wait_till_next_transmission

.wrap