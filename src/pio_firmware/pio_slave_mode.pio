.program pio_slave_mode

; SET pins GP0..GP4: bit 0 SC, bit 1 SI, bit 2 SO, bit 3 SD on GP3 (port pin 4), bit 4 SD on GP4 (port pin 1)
; OUT pins GP3..GP4, IN base GP3. ISR shifts left, OSR shifts right.
; Listens on both SD pins and replies only on the pin the parent's start bit came in on.

.define RX_TX_DONE_FLAG 0
.define TX_VALUE_FLAG 1

.wrap_target

set pins, 0b11000           ; SO low: the GBA's SI reads low and it becomes the parent
set pindirs, 0b00100        ; SO output, both SD pins input

set x, 15

; a start bit only counts once both SD pins have read high
idle:
    mov isr, ~null
    in pins, 2
    mov y, ~isr
    jmp y-- idle

; ISR stays all ones while both pins read high
start:
    in pins, 2
    mov y, ~isr             ; y = the SD pin(s) the start bit came in on
    jmp !y start

irq TX_VALUE_FLAG [20]      ; reply word requested early; first sample 1.5 bits after the start edge

receive_data:
    in pins, 2 [14]
    jmp x-- receive_data

push

; reply only if the stop bit was high on both pins
mov isr, ~null
in pins, 2
mov x, ~isr
jmp !x stop_ok
mov y, null
stop_ok:
mov osr, y
out pindirs, 2              ; SD output on the start-bit pin only, SO stays output

nop [27]                    ; gap between the parent's stop bit and the reply

set x, 15
pull                        ; reply, each bit doubled for the two SD pins
set pins, 0b00000 [16]      ; UART start bit
transmit_data:
    out pins, 2 [14]
    jmp x-- transmit_data

set pins, 0b11000 [16]      ; UART stop bit

irq RX_TX_DONE_FLAG

nop [31]                    ; idle time after the reply
.wrap
