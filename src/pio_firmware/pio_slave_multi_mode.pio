.program pio_slave_multi_mode

; SET pins GP0..GP4: bit 0 SC, bit 1 SI, bit 2 SO, bit 3 SD on GP3 (port pin 4), bit 4 SD on GP4 (port pin 1)
; OUT pins GP3..GP4, IN base GP3. ISR shifts left, OSR shifts right. MOV STATUS is all ones when the TX FIFO is empty.
; The GBA is the parent; the adapter answers with the words of the other players right after the GBA's word.
; TX FIFO per transfer: one word per other player in slot order, each bit doubled, queued by the CPU while the
; GBA's word arrives.
; SD is driven only on the pin the GBA's start bit came in on, and only after a stop bit on both pins: a partner
; that powers off pulls a pin low without one.

.define DONE_IRQ 0
.define TX_IRQ 1

.wrap_target
    set pins, 0b11000           ; SO low: the GBA is the parent
    set pindirs, 0b00100        ; SO output; SC, SI and both SD pins input
    set x, 15
wait_idle:
    mov isr, ~null
    in pins, 2
    mov y, ~isr
    jmp y-- wait_idle           ; until both SD pins are high
wait_start:
    in pins, 2                  ; ISR stays all ones while both pins are high
    mov y, ~isr
    jmp !y wait_start           ; y = the pin the start bit came in on
    irq TX_IRQ [20]             ; first sample in the middle of bit 0
receive_bit:
    in pins, 2 [14]
    jmp x-- receive_bit
    push
    mov isr, ~null              ; stop bit
    in pins, 2
    mov x, ~isr
    jmp !x drive
    mov y, null                 ; no stop bit: SD stays released
drive:
    mov osr, y
    out pindirs, 2
    nop [28]
transmit:
    set x, 15
    pull
    set pins, 0b00000 [16]      ; start bit
transmit_bit:
    out pins, 2 [14]
    jmp x-- transmit_bit
    set pins, 0b11000 [16]      ; stop bit
    nop [31]
    mov x, status
    jmp !x transmit             ; more players
    irq DONE_IRQ [31]
.wrap
