.program pio_master_mode

.define SD_PIN_OUT 1
.define SD_PIN_IN 1

.define PREP_NEXT_TRANSMISSION 0
.define RX_TX_DONE_FLAG 1

; Between Handshake cycle -> 30097 + cyles from .wraptarget till UART start bit

.wrap_target

set pindirs, 0b1101 ; pins SD | SO | SI | SC
set pins, 0b1101 

wait_till_next_transmission:
    jmp y-- wait_till_next_transmission

irq PREP_NEXT_TRANSMISSION[31] ; give irq time to fill fifo, this approach will keep timing constant

set pins, 0b1100 ; set SC low, martk start of complete transmission

pull
mov y osr ; seat number
transive_loop:
    jmp y-- transmit_data_for_player
    
    receive_data_from_seat:
        set pindirs, 0b0101 ; change SD to input
        set pins, 0b1000
        set x, 31 ; timeout value (~500us with delay, was ~50us)
        wait_for_rx:
            jmp x-- check_state [7] ; decrement x, delay 8 cycles per iteration
            check_state:
            jmp !x receive_begin ; x is zero -> begin receive of dummy values
            jmp pin wait_for_rx

        receive_begin:
        set x, 15 [22] ; delay to start sampling between duty cycle
        
        receive_data:
            in pins SD_PIN_IN [14]
            jmp x-- receive_data

        push [16] ; rx value

        set pindirs, 0b1101 ; change SD to output
        set pins, 0b1100 [29]
        jmp transive_loop

    transmit_data_for_player:
        mov x, status
        jmp x-- done ; tx fifo empty
        pull
        set pins, 0b0100 [15] ; UART start bit

        transmit_data:
            out pins, SD_PIN_OUT [14]
            jmp !osre transmit_data ; FIXME set shift_pull to 16

        set pins, 0b1100 [15] ; UART stop bit
        jmp transive_loop

done:
irq RX_TX_DONE_FLAG [31]

pull ; timing value for next transmission
mov y osr ; store in y for wait_till_next_transmission

.wrap