.program pio_master_multi_mode

; SET pins GP0..GP4: bit 0 SC, bit 1 SI, bit 2 SO, bit 3 SD on GP3 (port pin 4), bit 4 SD on GP4 (port pin 1)
; OUT pins GP3..GP4, IN base GP3. ISR shifts left, OSR shifts right. MOV STATUS is all ones when the TX FIFO is empty.
; The adapter is the parent and sends the words of the other players; the GBA sends in its own slot.
; TX FIFO per transfer, queued by the CPU when the previous transfer is done:
;   control word: bits 0-1 SD output mask, bits 2-3 the GBA's slot (1-3), bits 4-31 gap before SC low
;   one word per other player in slot order, each bit doubled
; The mask is the pin the GBA answered on (0 until it has answered), so SD is never driven on a guess.
; Execution starts at done, which has the CPU queue the first transfer.

.define DONE_IRQ 0
.define WATCHDOG_IRQ 2

done:
    irq DONE_IRQ [31]
    pull [2]                    ; control word
    set pins, 0b11101           ; SC high: end of the previous transfer
    mov isr, osr                ; kept for the mask after the GBA's slot
    out pindirs, 2              ; SD output on the learned pin only
    out y, 2                    ; the GBA's slot
    out x, 28                   ; gap
gap:
    jmp x-- gap
    set pins, 0b11100 [2]       ; SC low: transfer start
.wrap_target
slot:
    jmp y-- transmit            ; every slot but the GBA's
    set pindirs, 0b00101        ; release SD for the GBA
    set pins, 0b11000           ; SO low: the GBA sends now
    mov osr, isr
    irq WATCHDOG_IRQ            ; the CPU ends the wait if no start bit comes
    mov isr, ~null
poll:
    in pins, 2                  ; ISR stays all ones while both pins are high
    mov x, ~isr
    jmp !x poll
public receive:
    set x, 15 [19]              ; first sample in the middle of bit 0
receive_bit:
    in pins, 2 [14]
    jmp x-- receive_bit
    push [16]
    out pindirs, 2              ; SD output on the learned pin again
    set pins, 0b11100 [30]      ; SO high
.wrap
transmit:
    mov x, status
    jmp x-- done                ; no words left
    pull noblock
    set pins, 0b00100 [15]      ; start bit
transmit_bit:
    out pins, 2 [14]
    jmp !osre transmit_bit
    set pins, 0b11100 [15]      ; stop bit
    jmp slot
