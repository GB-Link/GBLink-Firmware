.program pio_master_mode_gbc

.define SD_PIN_OUT 1
.define SD_PIN_IN 1

.define PREP_NEXT_TRANSMISSION_FLAG 0
.define RX_TX_DONE_FLAG 1
.define START_WATCHDOG_FLAG 2

; Between Handshake cycle -> 30097 + cyles from .wraptarget till UART start bit

.wrap_target

set pindirs, 0b10101 ; pins SD | NC | SO | SI | SC
set pins, 0b10101

wait_till_next_transmission:
    jmp y-- wait_till_next_transmission

irq PREP_NEXT_TRANSMISSION_FLAG

set x, 30
wait_for_tx_irq:
    jmp x-- wait_for_tx_irq [9] ; wait for irq to fill fifo with next timing value and tx value

set pins, 0b10100 ; set SC low, martk start of complete transmission

pull noblock
mov y osr ; seat number
transive_loop:
    jmp y-- transmit_data_for_player
    
    receive_data_from_seat:
        set pindirs, 0b00101 ; change SD to input
        set pins, 0b10000 ; pull SO

        irq START_WATCHDOG_FLAG
        wait 0 pin 0
        
        receive_begin:
        set x, 15 [22] ; delay to start sampling between duty cycle
        
        receive_data:
            in pins SD_PIN_IN [14]
            jmp x-- receive_data

        push [16] ; rx value

        set pindirs, 0b10101 ; change SD to output
        set pins, 0b10100 [29]
        jmp transive_loop

    transmit_data_for_player:
        mov x, status
        jmp x-- done ; tx fifo empty
        pull noblock
        set pins, 0b00100 [15] ; UART start bit

        transmit_data:
            out pins, SD_PIN_OUT [14]
            jmp !osre transmit_data 

        set pins, 0b10100 [15] ; UART stop bit
        jmp transive_loop

done:
irq RX_TX_DONE_FLAG [31]

pull ; timing value for next transmission
mov y osr ; store in y for wait_till_next_transmission

.wrap